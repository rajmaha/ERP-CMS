{
  "name": "erp-cms",
  "version": "1.0.0",
  "description": "Modern CMS for ERP System with Dynamic Features",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed-admin": "node scripts/seedAdmin.js",
    "setup": "node scripts/reset-and-setup.js",
    "reset-password": "node scripts/reset-admin-password.js",
    "test-api": "node test-api.js",
    "client": "cd client && npm start",
    "server": "nodemon server.js",
    "both": "concurrently \"npm run server\" \"npm run client\""
  },
  "keywords": [
    "cms",
    "erp",
    "dynamic",
    "seo"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.2",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^6.10.0",
    "express-validator": "^7.0.1",
    "helmet": "^7.0.0",
    "image-size": "^1.0.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^7.5.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^7.0.11",
    "slugify": "^1.6.6"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "concurrently": "^7.0.0"
  }
