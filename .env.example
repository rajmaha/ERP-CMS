# Environment Configuration Example
# Copy this file to .env and update the values

# =================================
# Application Configuration
# =================================
NODE_ENV=production
PORT=5000
APP_PORT=5000
FRONTEND_URL=https://yourdomain.com
SITE_URL=https://yourdomain.com
API_URL=http://localhost:5000

# =================================
# MongoDB Configuration
# =================================
# For local development:
# MONGODB_URI=mongodb://localhost:27017/erp-cms

# For Docker:
MONGODB_URI=mongodb://admin:changeme123@mongodb:27017/erp_cms?authSource=admin
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=changeme123
MONGO_DB_NAME=erp_cms
MONGO_PORT=27017

# =================================
# JWT Configuration
# =================================
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars
JWT_EXPIRE=30d

# =================================
# Upload Configuration
# =================================
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=5242880

# =================================
# Admin User (Initial Setup)
# =================================
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@123
ADMIN_NAME=Admin User

# =================================
# SMTP Configuration (Optional)
# =================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@yourdomain.com
SMTP_FROM_NAME=ERP CMS
SMTP_SECURE=false

# =================================
# React App Configuration
# =================================
REACT_APP_API_URL=https://yourdomain.com

